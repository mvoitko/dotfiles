#!/usr/bin/env zsh
# Modular zsh configuration

# Path to oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"

# Source modular config files
[[ -f ~/.config/zsh/exports.zsh ]] && source ~/.config/zsh/exports.zsh
[[ -f ~/.config/zsh/plugins.zsh ]] && source ~/.config/zsh/plugins.zsh

# Disable theme — Starship handles the prompt
ZSH_THEME=""

# Load oh-my-zsh
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# Source remaining modules (after oh-my-zsh so aliases can override)
[[ -f ~/.config/zsh/aliases.zsh ]] && source ~/.config/zsh/aliases.zsh
[[ -f ~/.config/zsh/functions.zsh ]] && source ~/.config/zsh/functions.zsh
[[ -f ~/.config/zsh/keybindings.zsh ]] && source ~/.config/zsh/keybindings.zsh
[[ -f ~/.config/zsh/completions.zsh ]] && source ~/.config/zsh/completions.zsh

# Tool initializations (guarded — tools may not be installed yet)
command -v starship &>/dev/null && eval "$(starship init zsh)"

# pyenv (OMZ plugin handles basic init; we add virtualenv-init)
export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv &>/dev/null && eval "$(pyenv virtualenv-init -)" 2>/dev/null

# nvm (lazy-loaded for faster shell startup)
export NVM_DIR="$HOME/.nvm"
[ -s "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm/nvm.sh" ] && \. "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm/nvm.sh"
[ -s "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm/etc/bash_completion.d/nvm" ] && \. "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm/etc/bash_completion.d/nvm"

# direnv is handled by the OMZ direnv plugin — no explicit eval needed

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
