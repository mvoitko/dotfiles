{
    "dashboard.projectData": null,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.renderControlCharacters": true,
    "editor.rulers": [
        72, 79, 120
    ],
    "editor.suggestSelection": "first",
    "eslint.onIgnoredFiles": "warn",
    "files.autoSave": "afterDelay",
    "git.autofetch": true,
    "jupyter.allowUnauthorizedRemoteConnection": true,
    "projectManager.git.baseFolders": [
        "~/projects"
    ],
    "python.analysis.completeFunctionParens": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.logLevel": "Information",
    "python.analysis.typeCheckingMode": "strict",
    "python.autoComplete.addBrackets": true,
    "python.diagnostics.sourceMapsEnabled": true,
    "python.languageServer": "Pylance",
    "python.linting.flake8CategorySeverity.E": "Hint",
    "python.linting.flake8Enabled": true,
    "python.linting.mypyEnabled": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.testing.pytestEnabled": true,
    "python.venvPath": "~/.virtualenvs",
    "search.useGlobalIgnoreFiles": true,
    "vsicons.presets.tsOfficial": true,
    "vsintellicode.features.python.deepLearning": "enabled",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "vs-kubernetes": {},
    "workbench.colorTheme": "Default Dark+",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook",
        "git-rebase-todo": "default"
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.env.linux": {},
    "terraform.experimentalFeatures.prefillRequiredFields": true,
    "workbench.iconTheme": "vscode-icons",
    "[python]": {
        "editor.wordBasedSuggestions": "off",
        "gitlens.codeLens.symbolScopes": [
            "!Module"
        ],
        "editor.formatOnType": true
    },
    "redhat.telemetry.enabled": false,
    "editor.inlineSuggest.enabled": true,
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "editor.accessibilitySupport": "off",
    "go.toolsManagement.autoUpdate": true,
    "github.copilot.enable": {
        "*": true,
        "yaml": false,
        "plaintext": false,
        "markdown": false,
        "terraform": false
    },
    "yaml.schemas": {
    },
    "atlascode.bitbucket.enabled": true,
    "atlascode.jira.enabled": false,
    "cody.serverEndpoint": "https://sourcegraph.com/",
    "[terraform]": {
        "editor.guides.bracketPairs": "active",
        "editor.tabSize": 2
    },
    "[terraform-vars]": {
        "editor.tabSize": 2
    },
    "editor.guides.bracketPairs": true,
    "hadolint.hadolintPath": "/opt/homebrew/bin/hadolint",
    "amp.url": "https://ampcode.com/"
}
